# Optional — the app works with zero env vars (dev-mode console fallbacks).

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM="ReelPermit <orders@reelpermit.com>"
EMAIL_FROM_SUPPORT="ReelPermit Support <support@reelpermit.com>"
EMAIL_FROM_LICENSES="ReelPermit <licenses@reelpermit.com>"
EMAIL_FROM_APPLICATIONS="ReelPermit <applications@reelpermit.com>"
EMAIL_FROM_RECEIPTS="ReelPermit <receipts@reelpermit.com>"
EMAIL_FROM_BILLING="ReelPermit Billing <billing@reelpermit.com>"
SUPPORT_REPLY_TO=support@reelpermit.com
BUSINESS_LEGAL_NAME="ReelPermit"
BUSINESS_ADDRESS=
SUPPORT_EMAIL=support@reelpermit.com
SUPPORT_PHONE=
ADMIN_PANEL_SECRET=
ADMIN_BOOTSTRAP_EMAIL=admin@reelpermit.local
ADMIN_BOOTSTRAP_PASSWORD=
CRON_SECRET=
RESEND_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Postgres) --------------------------------------------------
DATABASE_URL=

# --- Admin console (MongoDB) ---------------------------------------------
# memory = in-process store (local UI / demos). Default in development if unset.
MONGODB_URI=memory
MONGODB_DB=reelpermit

# --- Payments (Whop) -------------------------------------------------
# Dashboard: https://whop.com (sandbox: https://sandbox.whop.com)
# Webhook URL: https://reelpermit.com/api/webhooks/whop  (event: payment.succeeded)
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# Optional product to attach one-time plans to.
# WHOP_PRODUCT_ID=
PAYMENT_DESCRIPTOR="REELPERMIT"
# NEXT_PUBLIC_WHOP_ENVIRONMENT=sandbox

# --- NMI (unused in production; kept for local simulated charges) ---
# NEXT_PUBLIC_NMI_TOKENIZATION_KEY=
# NMI_PRIVATE_SECURITY_KEY=
# NMI_WEBHOOK_SIGNING_KEY=

# --- Test promo ----------------------------------------------------------
# TESTREEL1 → $1.00 charge. TESTREEL0 → $0.00 (no card). Auto-enabled in local development.
# ALLOW_TEST_PROMO=true
# NEXT_PUBLIC_ALLOW_TEST_PROMO=true

# --- Cloudinary (DL / ID image uploads) ---------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
